rules_version = '2';

// Paste this into the Firebase console: Firestore Database -> Rules tab ->
// replace the contents -> Publish.
//
// The model: anyone reading the site can correct it, with no account at all.
// A correction goes live immediately but lands unacknowledged, which is what
// puts it on the card and in the owner's "✎ N rettet" queue. Nothing waits
// on the owner; the review happens after the fact rather than gating the
// change.
//
// What stops a script rather than a person is App Check, enforced in the
// console (App Check -> Firestore -> Enforce), not these rules -- it runs
// before them and rejects anything without a token from the real page. That
// is a weaker guarantee than a login and is a deliberate trade: hospital
// mail wouldn't deliver sign-in links, so the alternative was no colleague
// edits at all.
//
// Two things are still the owner's alone, and they're what make an
// unreviewed edit recoverable:
//   acknowledged - only the owner may set it, or an edit could mark itself
//                  reviewed and never surface in the queue.
//   delete       - only the owner may revert.
//
// Public read is required: that's how an override reaches every visitor
// rather than only whoever made it.

service cloud.firestore {
  match /databases/{database}/documents {

    // The owner's account is created by hand in the console; client-side
    // sign-up is off, so nothing else can create one. Matched on UID rather
    // than address, so this file -- which is public -- says nothing about
    // who the owner is. The UID grants nothing by itself; only the account's
    // password produces a token carrying it.
    function isOwner() {
      return request.auth != null
        && request.auth.uid == "XxGpRNqrdoXHcQ3zVMhFZtVLxkC3";
    }

    // Rejects anything carrying fields this app doesn't write, so the
    // collection can't be used as free storage.
    function knownFieldsOnly() {
      return request.resource.data.keys().hasOnly([
        'hidden', 'dismissed_flag', 'disease_groups', 'evidence_type',
        'updated_at', 'by', 'acknowledged'
      ]);
    }

    match /overrides/{pmid} {
      allow read: if true;

      allow create, update: if isOwner()
        || (knownFieldsOnly() && request.resource.data.acknowledged == false);

      allow delete: if isOwner();
    }

    // Everything else stays closed by default.
  }
}
